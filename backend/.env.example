# Copy this file to .env and replace the placeholders.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
FRONTEND_URL=http://localhost:5173

# Backend only. Never put this value in frontend/.env or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local Ollama AI Request Analysis; model data stays on this computer.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional; enables non-sensitive model-invocation logs in development only.
# APP_ENV=development

# Persistent Patient chat history (migration 008). OFF unless exactly "true".
# Keep false until the chat-history security tests pass. Deleting a conversation
# stays available to its owner either way.
HASF_CHAT_HISTORY_ENABLED=false

# Patient service requests and Technician tasks (migrations 010-012). OFF unless
# exactly "true". Keep false until those migrations are applied to the live
# Supabase project and verified. While false, every endpoint returns 503
# "This feature is not available yet." after authentication and role checks.
HASF_SERVICE_REQUESTS_ENABLED=false

# Appointment scheduling (migration 013). Also requires HASF_SERVICE_REQUESTS_ENABLED=true.
# Keep false until 013 has been reviewed and applied to the live project.
HASF_APPOINTMENTS_ENABLED=false
