VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Shows the Patient "Service Requests" page and the Technician "Tasks" page in the sidebar.
# ON only when exactly "true". Keep false until migrations 010-012 are applied and verified,
# and switch it on together with HASF_SERVICE_REQUESTS_ENABLED=true in backend/.env.
# This only hides navigation; the backend enforces the real gate.
VITE_SERVICE_REQUESTS_ENABLED=false

# Replaces the Patient "AI Request History" sidebar item with "Appointments". Needs migration 013
# and HASF_APPOINTMENTS_ENABLED=true on the backend. Keep false until 013 is applied.
VITE_APPOINTMENTS_ENABLED=false
